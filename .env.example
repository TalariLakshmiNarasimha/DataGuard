# DataGuard Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dataguard
DB_USER=dataguard
DB_PASSWORD=dataguard_secret

# Application settings
LOG_LEVEL=INFO
BATCH_SIZE=1000
DATA_DIR=data
